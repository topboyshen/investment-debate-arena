[Unit]
Description=Read-only existing daily reports for the project portal
After=local-fs.target
Wants=project-portal-inputs.service
After=project-portal-inputs.service

[Service]
Type=oneshot
User=root
Group=www-data
ExecStart=/usr/bin/python3 -B /opt/investment-debate-arena/scripts/export_reports.py
UMask=0027
StateDirectory=project-portal
StateDirectoryMode=0750
TimeoutStartSec=45
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
ReadWritePaths=/var/lib/project-portal
InaccessiblePaths=-/opt/mini-hermes/.env -/opt/signal-gate/secrets.env -/etc/nginx -/etc/netdata -/opt/mini-hermes/workspace -/opt/signal-gate/inbox
MemoryMax=128M
TasksMax=16
LimitNOFILE=64
